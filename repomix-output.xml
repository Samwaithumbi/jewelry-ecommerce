                </li>
                <li className="flex items-center gap-3">
                  <div className="auth-trust-icon">✓</div>
                  <span className="text-sm text-gray-300">Exclusive Member Benefits</span>
                </li>
                <li className="flex items-center gap-3">
                  <div className="auth-trust-icon">✓</div>
                  <span className="text-sm text-gray-300">Priority Customer Support</span>
