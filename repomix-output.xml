            <p className="text-sm text-muted-foreground">
              Never miss a special occasion. We'll send you an email 3 weeks before each date.
            </p>
          </div>
        </div>

        <ReminderForm onAdd={handleAddReminder} />

        {reminders.length > 0 && (
          <div className="mt-6 space-y-3">
