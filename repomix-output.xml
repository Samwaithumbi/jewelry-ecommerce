          </div>
          <div className="text-right">
            <p className="font-semibold text-[#111827]">
              ${(order.totalCents / 100).toFixed(2)}
            </p>
            <Link href={`/account/orders/${order.id}`}>
              <Button variant="ghost" size="sm" className="text-[#B88E2F] hover:text-[#B88E2F]/80">
                View Details
              </Button>
            </Link>
          </div>
        </div>
      </CardContent>
    </Card>
  )
}
